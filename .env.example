# =============================================================================
# Toalhas Express — variáveis de ambiente (NUNCA commitar valores reais)
# Copie para .env.local em desenvolvimento. Em staging/produção, configure na
# Vercel com credenciais SEPARADAS por ambiente. Ver docs/DEPLOYMENT.md.
# =============================================================================

# Ambiente lógico: development | staging | production
APP_ENV=development
# URL pública da aplicação (https obrigatório em produção). Usada no CSRF e em links de e-mail.
APP_URL=http://localhost:3000

# --- Supabase ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Chave PUBLICÁVEL (sb_publishable_...). Pode ir ao navegador.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chave SECRETA/service role. Somente servidor. Nunca prefixar com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Conexão PostgreSQL do backend (Supavisor, modo transação, porta 6543).
# postgres://postgres.<project-ref>:<senha>@aws-0-<região>.pooler.supabase.com:6543/postgres
DATABASE_URL=
DATABASE_POOL_MAX=5

# --- Segurança ----------------------------------------------------------------
# Segredo da Vercel Cron para acionar o worker (>= 32 caracteres aleatórios).
# Gere com: openssl rand -base64 48
CRON_SECRET=
# Pepper para hashes de rate limit/identificadores (>= 32 caracteres aleatórios).
APP_HASH_PEPPER=
# Janela do step-up (MFA recente) em segundos.
STEP_UP_MAX_AGE_SECONDS=600

# --- n8n (Fase 11; opcional até lá) -------------------------------------------
# Sem estes valores os eventos do outbox permanecem PENDING (nada se perde).
N8N_OUTBOX_WEBHOOK_URL=
N8N_OUTBOX_HMAC_SECRET=

# --- Asaas (Fase 10) — ainda não utilizadas -----------------------------------
# ASAAS_API_URL=https://api-sandbox.asaas.com/v3
# ASAAS_API_KEY=
# ASAAS_WEBHOOK_TOKEN=

# --- Google Maps (Fases 2 e 5) — ainda não utilizadas --------------------------
# NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=   (restrita por domínio + Maps JavaScript API)
# GOOGLE_MAPS_SERVER_KEY=                (restrita por IP/API: Geocoding, Routes)

LOG_LEVEL=info

# --- Testes -------------------------------------------------------------------
# Banco descartável para testes de integração (nome precisa terminar em _test).
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/toalhas_test
